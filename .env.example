# Mini-Agent Configuration
# Copy this file to .env and fill in your values.

# Required: Your MiniMax API key
# Get from: https://platform.minimax.io (Global) or https://platform.minimaxi.com (China)
MINIMAX_API_KEY=your_api_key_here

# API base URL (default: https://api.minimax.io for global)
# China: https://api.minimaxi.com
MINIMAX_API_BASE=https://api.minimax.io

# Model name (default: MiniMax-M2.7)
MINIMAX_MODEL=MiniMax-M2.7

# LLM provider: "anthropic" (default) or "openai"
LLM_PROVIDER=anthropic

# Max execution steps (default: 50)
MINI_AGENT_MAX_STEPS=50

# Platform mode: "auto", "windows", or "linux" (default: auto)
MINI_AGENT_PLATFORM=auto

# Approval timeout in seconds for AGENT mode (default: 10)
MINI_AGENT_APPROVAL_TIMEOUT=10

# Auto-save session after each step (default: true)
MINI_AGENT_AUTO_SAVE=true

# Stream buffer size for LLM streaming (default: 8)
MINI_AGENT_STREAM_BUFFER_SIZE=8

# Cache warmup on startup (default: true)
MINI_AGENT_CACHE_WARMUP=true
